NODE_ENV="development"

# PostgreSQL — Neon or any Postgres provider
# SECURITY: sslmode=require is mandatory in production.
# Restrict DB port access to the backend server IP only — never expose it publicly.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host-direct/db?sslmode=require"

# JWT — generate with: node -e "require('crypto').randomBytes(32,(e,b)=>console.log(b.toString('hex')))"
# Must be 64 hex chars (32 bytes). Never use the default in production.
JWT_SECRET="<generate-a-strong-random-secret>"

# Dev auth bypass — set to "true" ONLY for local Expo Go testing, never in production
ENABLE_DEV_INTEGRATION_AUTH_BYPASS="false"

PORT=3001

# SMTP — leave blank to log emails to console (dev mode)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Futurely" <noreply@futurely.app>'

# Public web-app URL for email links and post-OAuth web redirects.
APP_URL="https://app.futurely.app"

# Public HTTPS base URL that OAuth providers call back to. The provider
# consoles must allow the /api/auth/oauth/{provider}/callback paths beneath it.
OAUTH_CALLBACK_BASE_URL="https://api.futurely.app"

# Comma-separated allowed CORS origins in production (leave blank for mobile-only)
# Example: "https://app.futurely.app,https://admin.futurely.app"
ALLOWED_ORIGINS=""

# HAC integration test account
HAC_TEST_DISTRICT_URL="https://homeaccess.katyisd.org/HomeAccess/Account/LogOn"
HAC_TEST_USERNAME=""
HAC_TEST_PASSWORD=""

# AES-256-GCM key for encrypting stored HAC/Canvas credentials
# Generate: node -e "require('crypto').randomBytes(32,(e,b)=>console.log(b.toString('hex')))"
CREDENTIAL_ENCRYPTION_KEY="<64-hex-chars>"

# OpenRouter API key — used for AI chat features (ai.ts, parent.ts, collegeInsights.ts)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# College Scorecard API key — used for live college search and admissions data
# Register at https://api.data.gov/signup/ — free, instant key issuance
# SECURITY: backend-only. Never expose via NEXT_PUBLIC_* or client-accessible endpoints.
COLLEGE_SCORECARD_API_KEY=""

# OpenRouter model used for all AI features (ai.ts, parent.ts, collegeInsightsPrompt.ts)
# Defaults to "openrouter/free" if unset
AI_MODEL=""

# Complexity-based model routing (set by resolveTierForScore in aiClient.ts).
# When unset, falls back to AI_MODEL / the provider default.
AI_MODEL_BASIC=      # Model for prompts scored 1-50 (basic HS-level questions, OpenRouter)
# AI_MODEL_ADVANCED — DEPRECATED, has no effect. Use NVIDIA_MODEL to control the advanced chat tier (score 51-100).

# NVIDIA NIM API key — used for the advanced chat tier (complexity score 51-100).
# Get one at https://build.nvidia.com — free tier available.
# When absent, advanced-tier prompts fall through to the basic (OpenRouter) tier.
NVIDIA_API_KEY=""

# NVIDIA NIM model for the advanced tier (score 51-100).
# Also governs the NVIDIA model used when AI_PROVIDER=nvidia (legacy env-var routing).
# Defaults to meta/llama-3.1-70b-instruct if unset.
NVIDIA_MODEL=""

# Max age (days) before a cached college insight is regenerated. Defaults to 90 if unset.
COLLEGE_INSIGHTS_MAX_CACHE_AGE_DAYS="90"
